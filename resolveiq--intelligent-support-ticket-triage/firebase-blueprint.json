{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered operator, engineer or admin profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "name": {
          "type": "string",
          "description": "User's full name"
        },
        "mobile": {
          "type": "string",
          "description": "User's mobile telephone number"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "role": {
          "type": "string",
          "enum": ["operator", "engineer", "admin"],
          "description": "Access role within ResolveIQ"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of user registration"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "ISO timestamp of last sign in"
        }
      },
      "required": ["uid", "name", "mobile", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Directory of registered people with name, mobile, and email"
    }
  }
}
